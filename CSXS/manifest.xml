<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="10.0" ExtensionBundleId="com.uzbek.subtitles" ExtensionBundleVersion="1.0.0"
    ExtensionBundleName="O'zbekcha AI Subtitr" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.uzbek.subtitles.panel" Version="1.0.0" />
    </ExtensionList>
    
    <ExecutionEnvironment>
        <HostList>
            <!-- Adobe After Effects (2019 - 2026+) -->
            <Host Name="AEFT" Version="[16.0,99.9]" />
            <!-- Adobe Premiere Pro (2019 - 2026+) -->
            <Host Name="PPRO" Version="[13.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="10.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>

    <DispatchInfoList>
        <Extension Id="com.uzbek.subtitles.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/shared.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>O'zbekcha AI Subtitr</Menu>
                    <Geometry>
                        <Size>
                            <Height>700</Height>
                            <Width>420</Width>
                        </Size>
                        <MinSize>
                            <Height>450</Height>
                            <Width>340</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>1600</Height>
                            <Width>1200</Width>
                        </MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
